#!/usr/bin/bash
# The whole session on AzrakOS (minimal edition): Gamescope, full screen on the TV, with
# Azrak Launcher in it. greetd starts this for "player" at boot (/etc/greetd/config.toml).
#
set -u
# The launcher lives in the user's home folder so it can update itself; the copy in the OS image
# only installs it the first time (or if it was removed). One from before Azrak (Azrak Launcher)
# still has its old name until its first start as Azrak moves it over, so this is checked before
# every start.
seed=/usr/share/azrak-os/release
log="$HOME/.cache/azrak-os.log"
mkdir -p "$HOME/.cache"
rm -f "$HOME/.cache/ps5-launcher-os.log"  # from before Azrak
# A launcher that really runs: it answers --version. A copy cut short (the PC switched off while it
# was copied the first time) is an empty file, which bash "runs" without complaint.
runs() {
    case "$("$1" --version 2>/dev/null)" in azrak* | ps5-launcher*) return 0 ;; esac
    return 1
}
pick() {
    bin="$HOME/.local/bin/azrak"
    runs "$bin" || ! runs "$HOME/.local/bin/ps5-launcher" || bin="$HOME/.local/bin/ps5-launcher"
    if ! runs "$bin"; then
        echo "$(date -Is) installing Azrak Launcher from the OS image" >>"$log"
        rm -f "$bin"
        "$seed/install.sh" >>"$log" 2>&1 || { mkdir -p "${bin%/*}" && cp "$seed/azrak" "$bin"; } 2>>"$log"
        sync "$bin" 2>/dev/null
    fi
    runs "$bin" || bin="$seed/azrak"
}
pick

# Games and the launcher run on Gamescope's X server: the launcher switches between itself and a
# game through Gamescope's Steam mode (-e), which works with X11 windows. SDL (the emulators) and
# Qt are told so explicitly; games inherit this.
export SDL_VIDEO_DRIVER=x11 SDL_VIDEODRIVER=x11 QT_QPA_PLATFORM=xcb GDK_BACKEND=x11
# If the launcher quits or crashes, start it again rather than leave a black screen. If Gamescope
# itself can't start (a graphics card it can't drive, no Vulkan driver), show the launcher in a
# plain kiosk display instead, where Settings → This PC says what's missing; games won't start
# there, but the screen isn't black.
# The session starts with the PC, usually just before the network: give it a moment, so the first
# downloads don't fail, but only a short one (the screen is black meanwhile, between the boot
# screen and the launcher). The launcher retries anything that failed when the network comes up.
nm-online -q -t 5 || echo "$(date -Is) no network yet; starting anyway" >>"$log"
# The launcher logs "window shown" once its window is up (older releases: "welcome screen ready" or
# "home screen shown", which a launcher started on the USB stick's welcome never logs). If none
# comes within 90 s of starting (seen once in a VM: it hung before its window, and the screen
# stayed black for good), it's stopped and started again rather than leaving the TV black.
shown_since() {
    tail -c +"$(( $1 + 1 ))" "$log" 2>/dev/null | grep -qaE '\] (window shown|welcome screen ready|home screen shown)$'
}
# Wait for the display server PID (Gamescope or cage) to end; true when the watchdog ended it.
watch() {
    local pid=$1 mark=$2 kiosk=$3 t0 shown= running child
    t0=$(date +%s)
    while sleep 2 && kill -0 "$pid" 2>/dev/null; do
        [ -n "$shown" ] || ! shown_since "$mark" || shown=1
        if [ -z "$shown" ] && [ $(( $(date +%s) - t0 )) -ge 90 ]; then
            echo "$(date -Is) nothing on screen after 90 s; starting again" >>"$log"
            kill "$pid"
            wait "$pid"
            return 0
        fi
        # cage doesn't always notice its app ending (it would sit on a black screen): end it once
        # the launcher is gone, so the loop starts both again.
        if [ -n "$kiosk" ]; then
            running=
            for child in $(pgrep -P "$pid" -x 'azrak|ps5-launcher'); do
                [ "$(cut -d' ' -f3 "/proc/$child/stat" 2>/dev/null)" != Z ] && running=1
            done
            [ -n "$running" ] || [ $(( $(date +%s) - t0 )) -lt 4 ] || { kill "$pid"; break; }
        fi
    done
    wait "$pid"
    return 1
}

failures=0
while true; do
    pick
    started=$(date +%s)
    mark=$(stat -c %s "$log" 2>/dev/null || echo 0)
    # Gamescope needs a launcher that tags its window (older releases don't, and Gamescope would
    # show nothing) and a graphics card it can drive (two quick exits in a row, or twice nothing
    # on screen: it can't). Checked every time, so a launcher that updated itself moves to Gamescope.
    if ! "$bin" --supports gamescope 2>/dev/null; then
        why="this launcher version can't run in Gamescope yet"
    elif [ "$failures" -ge 2 ]; then
        why="Gamescope can't run on this graphics card"
    else
        why=
    fi
    if [ -z "$why" ]; then
        echo "$(date -Is) starting in Gamescope" >>"$log"
        gamescope -e --xwayland-count 1 -- "$bin" >>"$log" 2>&1 &
        if watch $! "$mark" "" || [ $(( $(date +%s) - started )) -lt 15 ]; then
            failures=$((failures + 1))
        else
            failures=0
        fi
    else
        echo "$(date -Is) $why; starting in a basic display" >>"$log"
        cage -s -- "$bin" >>"$log" 2>&1 &
        watch $! "$mark" kiosk
    fi
    sleep 2
done
