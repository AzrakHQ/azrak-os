# AzrakOS, minimal edition: Fedora's bootable container base with only what a console
# needs (drivers and firmware, Gamescope, networking, Bluetooth, sound) and Azrak Launcher as the
# whole screen. No desktop: the launcher's Settings → System does Wi-Fi, pairing, sound output,
# updates and power. Updates replace the whole system atomically (bootc), with the previous one
# kept in the boot menu. Build from this repo (bootc-base-imagectl needs the extra privileges):
#   podman build --cap-add=all --security-opt=label=disable --device /dev/fuse -f minimal/Containerfile .
# then split it into one layer per package (the workflow does this), so updates only download what changed:
#   podman run --rm --privileged -v /var/lib/containers:/var/lib/containers quay.io/fedora/fedora-bootc:44 \
#     /usr/libexec/bootc-base-imagectl rechunk IMAGE-BUILT IMAGE
ARG BASE_IMAGE=quay.io/fedora/fedora-bootc:44
FROM ${BASE_IMAGE} AS builder
# Fedora's smallest bootable set (bootc, systemd, the kernel, dnf), from Fedora's own packages: its
# standard base is a headless server (cloud SDKs, QEMU for other processors, LVM, toolbox), about a
# fifth of the download that a console never uses.
RUN /usr/libexec/bootc-base-imagectl build-rootfs --manifest=minimal / /target-rootfs

FROM scratch
COPY --from=builder /target-rootfs/ /

RUN set -eux; \
    dnf5 -y install --setopt=install_weak_deps=False \
        # Display: Gamescope with its X server; Mesa covers AMD, Intel and (NVK) NVIDIA.
        gamescope xorg-x11-server-Xwayland greetd cage \
        mesa-dri-drivers mesa-vulkan-drivers vulkan-loader mesa-libEGL mesa-libGL libglvnd-gles libglvnd-opengl \
        # Firmware for graphics cards, Wi-Fi, Bluetooth and sound.
        linux-firmware amd-gpu-firmware intel-gpu-firmware nvidia-gpu-firmware amd-ucode-firmware \
        iwlwifi-mvm-firmware iwlwifi-dvm-firmware atheros-firmware brcmfmac-firmware mt7xxx-firmware \
        realtek-firmware intel-audio-firmware alsa-sof-firmware \
        # Network, Bluetooth, sound.
        NetworkManager NetworkManager-wifi wpa_supplicant bluez \
        pipewire pipewire-pulseaudio pipewire-alsa wireplumber alsa-ucm pulseaudio-utils \
        # What the launcher and the emulators load (X11/Wayland, audio, input, archives, trailers).
        libX11 libXext libXcursor libXi libXfixes libXrandr libXScrnSaver libXtst \
        libxkbcommon libxkbcommon-x11 libwayland-client libwayland-cursor libwayland-egl \
        alsa-lib pulseaudio-libs dbus-libs libuuid libcap libarchive mpv-libs yt-dlp \
        xdotool xprop \
        # Not in Fedora's minimal set, but used: tar (the launcher's and emulators' updates), lspci
        # (Settings → This PC names the graphics card), rpm-ostree (Settings → System's update
        # status), chrony (the clock, and HTTPS needs the right time).
        tar pciutils rpm-ostree chrony \
        # The boot screen: the Azrak logo instead of text (minimal/files/…/plymouth/themes/azrak).
        plymouth plymouth-theme-spinner \
        fontconfig google-noto-sans-fonts google-noto-sans-arabic-fonts google-noto-emoji-fonts; \
    dnf5 clean all

# Universal Blue's kernel-module key: NVIDIA's driver (the :minimal-nvidia version) is signed with
# it, and with Secure Boot on the PC needs it enrolled once (azrak-os/update queues it).
RUN set -eux; \
    curl -fsSL --retry 3 -o /usr/share/azrak-os-secureboot.der https://github.com/ublue-os/akmods/raw/main/certs/public_key.der; \
    echo "4e5c68474cb133fd8984d9599762cece9100c3e6cd8a9709aeaabd85dd9e70d1  /usr/share/azrak-os-secureboot.der" | sha256sum -c -; \
    mkdir -p /usr/share/azrak-os; mv /usr/share/azrak-os-secureboot.der /usr/share/azrak-os/secureboot.der

# Shown in Settings → System (the workflow passes the build date). Declared after the packages so
# a new version doesn't download them all again.
ARG VERSION=dev

# The latest launcher release (unpacked by the workflow into launcher/). It only seeds the
# player's own copy in ~/.local/bin, which then updates itself.
COPY launcher/ /usr/share/azrak-os/release/
COPY minimal/files/ /

RUN set -eux; \
    chmod 0755 /usr/libexec/azrak-os/session /usr/libexec/azrak-os/update /usr/share/azrak-os/release/azrak \
        /usr/share/azrak-os/release/install.sh; \
    # The system calls itself AzrakOS (boot menu, Settings); the rest of os-release stays Fedora's,
    # which tools like dnf and bootc read.
    sed -i -e 's/^NAME=.*/NAME="AzrakOS"/' -e "s/^PRETTY_NAME=.*/PRETTY_NAME=\"AzrakOS $VERSION\"/" \
        -e 's/^DEFAULT_HOSTNAME=.*/DEFAULT_HOSTNAME="azrakos"/' -e 's|^HOME_URL=.*|HOME_URL="https://github.com/AzrakHQ/azrak-os"|' \
        -e 's|^SUPPORT_URL=.*|SUPPORT_URL="https://github.com/AzrakHQ/azrak-os/issues"|' \
        -e 's|^BUG_REPORT_URL=.*|BUG_REPORT_URL="https://github.com/AzrakHQ/azrak-os/issues"|' -e '/^LOGO=/d' /usr/lib/os-release; \
    # The boot screen, in the initramfs too so it shows from the start.
    cp -n /usr/share/plymouth/themes/spinner/*.png /usr/share/plymouth/themes/azrak/; \
    plymouth-set-default-theme azrak; \
    kver=$(cd /usr/lib/modules && echo *); \
    dracut --force --kver "$kver" "/usr/lib/modules/$kver/initramfs.img"; \
    # Tells the launcher it's the whole system (Settings → System).
    mkdir -p /usr/lib/azrak-os; \
    /usr/share/azrak-os/release/azrak --version | tee /usr/lib/azrak-os/release; \
    systemctl enable greetd.service NetworkManager.service bluetooth.service chronyd.service azrak-os-update.timer; \
    systemctl set-default graphical.target; \
    # Anaconda (and others) set text mode (multi-user.target) as the default: the console's
    # session must start there too.
    systemctl add-wants multi-user.target greetd.service; \
    # Fedora's update timer restarts the PC by itself; ours only downloads (Settings shows "Restart").
    systemctl mask bootc-fetch-apply-updates.timer; \
    rm -rf /var/cache/* /var/log/* /tmp/*; \
    bootc container lint

LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.title="AzrakOS (minimal)" \
      org.opencontainers.image.description="A PC that boots straight into Azrak Launcher: Fedora bootc, Gamescope, no desktop" \
      org.opencontainers.image.source="https://github.com/AzrakHQ/azrak-os" \
      org.opencontainers.image.licenses="Apache-2.0"
LABEL containers.bootc=1
ENV container=oci
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
